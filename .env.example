# ─── Clerk ─────────────────────────────────────────────────────────────────────
# Get these from: https://dashboard.clerk.com → Your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Tell Clerk which routes to use for sign-in/sign-up and where to land after.
# These match the pages we created in app/(auth)/.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Plaid ──────────────────────────────────────────────────────────────────────
# Get these from: https://dashboard.plaid.com → Team Settings → Keys
# Start with PLAID_ENV=sandbox — no real bank needed.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Required for OAuth banks (Chase, Capital One, etc.)
# Set to your Vercel deployment URL and register it as an allowed redirect URI in the Plaid dashboard
NEXT_PUBLIC_APP_URL=

# ─── Supabase ───────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
